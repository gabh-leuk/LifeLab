# 复制为 .env 并填入真实值
# 两种数据库选一个（取消对应行的注释）：

# —— SQLite（默认，零安装）——
# DATABASE_URL=sqlite:///./lifelab.db

# —— PostgreSQL（Docker 起库后）——
# 口令不是随便填的：它必须与根目录 .env 的 LIFELAB_DB_PASSWORD 相同
# （docker compose 从那里取，见 docs/SETUP_ENV.md「改库口令」）
DATABASE_URL=postgresql+psycopg://lifelab:<库口令>@localhost:5432/lifelab

# —— DeepSeek（OpenAI 兼容）——
# 填你的 API Key
LLM_API_KEY=
LLM_BASE_URL=https://api.edgefn.net/v1
LLM_MODEL=DeepSeek-V4-Flash

# —— 向量化（记忆检索）——
# 优先本地 Ollama（推荐，免费离线，AMD RX7000/8000 可 GPU 加速）
# 安装 Ollama 后：ollama pull qwen3-embedding:4b
EMBEDDING_PROVIDER=auto        # auto | ollama | openai
EMBEDDING_OLLAMA_URL=http://localhost:11434
EMBEDDING_OLLAMA_MODEL=qwen3-embedding:4b
# 可选：云 embedding API（auto 模式会在 Ollama 不可用时回退）
# EMBEDDING_API_KEY=
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_MODEL=BAAI/bge-m3
EMBEDDING_DIM=2560

# —— RAG 检索策略（可选，默认值已按 qwen3-embedding:4b 校准）——
# 相似度门槛：低于此值的候选直接丢弃（无关查询实测最高 0.52，正相关 ≥0.64）
RAG_MIN_SIMILARITY=0.56
# 时间权重：final = (1-w)*相似度 + w*时间新鲜度
RAG_TIME_WEIGHT=0.2
# 候选量：top_k * multiplier（上限 max_candidates）再过滤排序
RAG_CANDIDATE_MULTIPLIER=3
RAG_MAX_CANDIDATES=20
# 同 kind 去重：与已有条目余弦 ≥ 此值时跳过写入
RAG_DEDUP_THRESHOLD=0.92