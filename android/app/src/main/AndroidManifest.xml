<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 读取应用使用情况（特殊权限，需用户在系统设置里手动授予） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 包可见性：声明「可见带启动入口的应用」，
         否则 getLaunchIntentForPackage/getApplicationInfo 对第三方包返回 null，
         会把微信等普通应用全部误过滤（只采到系统包）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeLabCollector"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 内置 Web 端。旋转不重建：重建会把网页历史与滚动位置丢回去 -->
        <activity
            android:name=".WebViewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- 小组件配置页。exported 必须为 true：它是由桌面（别的应用）通过
             appwidget-provider 的 android:configure 拉起来的，每次带一个实例 id。 -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件。exported 必须为 true：APPWIDGET_UPDATE 由系统/桌面发起，
             写 false 在部分厂商桌面上收不到（默认值在 Android 12 之后才是 false）。
             就算被人伪造一条广播，也只是白刷一次计数，没有权限风险。 -->
        <receiver
            android:name=".RecordWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_record_info" />
        </receiver>

        <!-- 小组件按钮的落点。PendingIntent 由本应用创建，投递时用的是本应用的身份，
             所以不需要 exported。 -->
        <receiver
            android:name=".RecordActionReceiver"
            android:exported="false" />
    </application>
</manifest>
